flowchart TB

    A["<b>TRAINED DNN</b><br/>CIFAR-10<br/>ResNet-18 / VGG-16"]

    B["<b>SOFTWARE FAULT INJECTION</b><br/>Controlled Channel Stuck-at-Zero<br/>Convolutional Feature-Map Channels"]

    C["<b>TD3-BASED VULNERABILITY SEARCH</b><br/>Adaptive Fault-Location Selection"]

    D["<b>CHANNEL VULNERABILITY RANKING</b><br/>Fault-Impact-Based Prioritization"]

    E["<b>CROSS-LAYER INTERACTION ANALYSIS</b><br/>Individual vs Simultaneous Faults"]

    F["<b>VULNERABILITY-AWARE<br/>FAULT FINE-TUNING</b><br/>Clean + Faulted Training Objective"]

    G["<b>BUDGET-AWARE PROTECTION</b><br/>1% · 3% · 5% · 10%"]

    H["<b>PROTECTED DNN</b><br/>Clean Accuracy + Fault Robustness"]

    I["<b>EVALUATION</b><br/>Robustness · Accuracy · Search Efficiency<br/>Protection Efficiency · Computational Cost"]

    A --> B
    B --> C
    C --> D
    D --> E
    D --> F
    F --> G
    E --> G
    G --> H
    H --> I

    classDef input fill:#E0F2FE,stroke:#0284C7,stroke-width:2px,color:#0C4A6E;
    classDef fault fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#78350F;
